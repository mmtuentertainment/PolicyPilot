# .env.local.example
# PolicyPilot — Environment Variables
# Copy to .env.local and fill in values before running the app.

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Drizzle migrations + runtime connection (use Supabase pooler URI on port 6543 for runtime,
# direct URI on 5432 for migrations). See D-06 / D-07.
DATABASE_URL=

# ─── Clerk ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── Stripe ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create products in Dashboard first)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@policypilot.com

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# ─── Analytics / Monitoring ─────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# ─── Phase 2 (Data Layer) ───────────────────────────────
# Drizzle migrations need direct connection (port 5432) — pooler (6543)
# chokes on some DDL. See .planning/phases/02-data-layer/02-CONTEXT.md D-05.
DIRECT_URL=

# Second Supabase project for the RLS cross-org property test (L-06).
# Keeps test fixtures from trashing dev data.
DATABASE_URL_TEST=
DIRECT_URL_TEST=
