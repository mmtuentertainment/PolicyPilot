# .env.local.example
# PolicyPilot — Environment Variables
# Copy to .env.local and fill in values before running the app.

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Drizzle migrations + runtime connection (use Supabase pooler URI on port 6543 for runtime,
# direct URI on 5432 for migrations). See D-06 / D-07.
DATABASE_URL=

# ─── Clerk ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# After-sign-in redirect for the EMBEDDED <SignIn /> / <SignUp /> components
# shipped by Plan 03-11 at app/(auth)/sign-in/ and app/(auth)/sign-up/.
# These are read by @clerk/nextjs at module load.
#
# IMPORTANT: These env vars are distinct from Clerk Account Portal's
# "After sign-in fallback" config in the Clerk Dashboard — the Dashboard
# config governs Clerk's HOSTED portal only (clerk.<your-app>.com flows);
# the env vars below govern the embedded components in app/(auth)/.
# Both must point at the same /post-sign-in trampoline for the
# ROADMAP Phase 3 SC walkthrough to land in /dashboard. See GAP-3 in
# .planning/phases/03-admin-ui/03-SMOKE.md.
# Canonical value for PolicyPilot is `/post-sign-in` — paste it into .env.local.
# Documented in reference/STACK.md and asserted by scripts/check-foundation.ts
# (the 7th check fails verify:phase-1 if .env.local has these empty or
# pointing elsewhere). Template values intentionally blank per project
# convention (".env.local.example: every value must be empty").
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# ─── Stripe ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create products in Dashboard first)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# ─── Anthropic ──────────────────────────────────────────────
# Anthropic API key for Phase 4 AI Layer (Claude Sonnet 4.6 + Haiku 4.5).
# Server-only. NEVER expose client-side. Populate the real value in .env.local (gitignored).
ANTHROPIC_API_KEY=

# ─── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@policypilot.com

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# ─── Analytics / Monitoring ─────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# ─── Phase 2 (Data Layer) ───────────────────────────────
# Drizzle migrations need direct connection (port 5432) — pooler (6543)
# chokes on some DDL. See .planning/phases/02-data-layer/02-CONTEXT.md D-05.
DIRECT_URL=

# Second Supabase project for the RLS cross-org property test (L-06).
# Keeps test fixtures from trashing dev data.
DATABASE_URL_TEST=
DIRECT_URL_TEST=

# --- Phase 4 deploy-prep (staging + prod migration URLs) ---
# Staging + prod URLs do NOT live in .env.local or secrets/*.env files.
# The package.json `db:migrate:staging` / `db:migrate:prod` and matching
# verify scripts materialize DATABASE_URL + DIRECT_URL at runtime through
# scripts/with-deploy-creds.ps1, using:
#
#   - scripts/deploy-config.json for non-secret routing
#   - PowerShell SecretStore entries PolicyPilotStagingDB / PolicyPilotProdDB
#     for the database password
#
# URL shape only, with placeholders:
#   DATABASE_URL=postgres://postgres.<project_ref>:<password>@aws-...-pooler.supabase.com:6543/postgres
#   DIRECT_URL=postgres://postgres.<project_ref>:<password>@aws-...-pooler.supabase.com:5432/postgres
#
# Full procedure: docs/runbooks/deploy-migrations.md and docs/runbooks/launch-mvp.md
